# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
#
# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config.

# DMS 가 Material3 색으로 생성하는 테마 (~/.config/ghostty/themes/dankcolors)
theme = dankcolors

# background-opacity = 0.8
# background-blur = true
# background-blur-radius = 20

# 커서를 그 밑 글자 색의 반전으로 그린다 (helix 의 ui.cursor = reversed 와 같은 모양)
cursor-invert-fg-bg = true

## -- new split keybind to Set up like as Mac Ghostty default (cmd+d , cmd+shift+d)
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down 

# quick-terminal(alt+space) 은 mac(config.mac) 에서만. linux 에선 DMS spotlight 가 alt+space 를 쓴다.
