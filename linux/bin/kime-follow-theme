#!/usr/bin/env bash
# kime 트레이 아이콘 색을 DMS 라이트/다크에 맞춘다.
# DMS 가 색을 뽑을 때 matugen 이 ~/.config/kime/config.yaml 을 다시 만들고(템플릿: linux/matugen/templates/kime.yaml),
# 그 post_hook 으로 이 스크립트를 부른다. kime 은 설정을 시작할 때만 읽어서 바뀌었으면 다시 시작한다.
#
# 배경화면만 바뀌어도 hook 이 불리므로, 아이콘 색이 실제로 바뀌었을 때만 재시작한다 (재시작 중 1초쯤 한글 입력이 끊긴다)
set -euo pipefail

conf="$HOME/.config/kime/config.yaml"
state="$HOME/.cache/kime-icon-color"

color=$(sed -n 's/^[[:space:]]*icon_color:[[:space:]]*//p' "$conf" | head -1)
[ -n "$color" ] || exit 0
[ "$(cat "$state" 2>/dev/null)" = "$color" ] && exit 0

mkdir -p "$(dirname "$state")"
echo "$color" >"$state"

# kime 은 xdg 자동 시작으로 systemd 사용자 서비스가 된다. 없으면 직접 띄운다
if systemctl --user is-active --quiet app-kime@autostart.service; then
  systemctl --user restart app-kime@autostart.service
elif pgrep -x kime >/dev/null; then
  pkill -x kime
  sleep 0.5
  setsid -f kime >/dev/null 2>&1
fi
